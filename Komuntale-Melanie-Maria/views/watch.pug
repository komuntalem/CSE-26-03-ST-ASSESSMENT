extends layout
block content
  .watch-page
    header.watch-header
      a.back-btn(href="/videos")
        span ←
        span  Back
      a.logo(href="/")
        span.logo-icon ▶
        span.logo-text Videx

    main.watch-main
      if video.videoFile
        video.video-player(controls autoplay)
          source(src=`/uploads/${video.videoFile}`)
          | Your browser does not support the video tag.
      else
        .watch-placeholder
          p No video file is available for this preview.

      .watch-info
        h1.watch-title= video.title
        .watch-meta
          span= video.views + ' views'
          span.dot ·
          span= new Date(video.createdAt).toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'})
          span.dot ·
          span.quality-badge= video.quality
        if video.description
          p.watch-desc= video.description